+    fn _now() -> u64 {
+        // libctru's monotonic kernel tick uses the fixed ARM11 system clock.
+        extern "C" { fn svcGetSystemTick() -> i64; }
+        const TICKS_PER_SECOND: u64 = 268_123_480;
+        let ticks = unsafe { svcGetSystemTick() } as u64;
+        _timespec_to_u64(ticks / TICKS_PER_SECOND,
+            ((ticks % TICKS_PER_SECOND) * 1_000_000_000 / TICKS_PER_SECOND) as u32)
     }
 
